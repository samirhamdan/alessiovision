# Copie para deploy/.env (usado pelo docker compose) e ajuste os valores.

# Credencial do agente de demonstração. Gere uma nova, por exemplo:
#   python -c "import secrets; print('alg_' + secrets.token_urlsafe(32))"
ALESSIO_DEMO_AGENT_TOKEN=troque-este-token

# Login de demonstração no painel (proprietário da organização demo).
ALESSIO_DEMO_OWNER_EMAIL=demo@example.com
# Pelo menos 10 caracteres.
ALESSIO_DEMO_OWNER_PASSWORD=troque-esta-senha

POSTGRES_PASSWORD=alessio

# Horário simulado do primeiro quadro do vídeo de demonstração.
ALESSIO_REPLAY_START=2026-10-23T23:00:00-03:00
# true para reproduzir o vídeo no ritmo real (útil para acompanhar o painel ao vivo).
ALESSIO_REALTIME=false
