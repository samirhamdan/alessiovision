# Copie para deploy/vps/.env e preencha. Este arquivo nunca vai para o Git.

# Endereço público do painel (sem https://).
ALESSIO_DOMAIN=alessio-vision.duckdns.org

# Senha do PostgreSQL. Use só letras e números. Para gerar uma:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Onde o painel escuta para o Caddy (mesma interface dos outros sistemas).
ALESSIO_BIND=172.18.0.1
ALESSIO_PORT=5010

# --- Só para a demonstração (opcional) ---
# Token do agente de demonstração. Para gerar:  openssl rand -hex 24
ALESSIO_DEMO_AGENT_TOKEN=
# Login do proprietário da "Organização Demo". Senha com pelo menos 10 caracteres.
ALESSIO_DEMO_OWNER_EMAIL=
ALESSIO_DEMO_OWNER_PASSWORD=
